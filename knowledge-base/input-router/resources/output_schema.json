{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-creator.local/schemas/input-router-output.schema.json",
  "title": "Input Router Output",
  "description": "Structured brief produced by the input-router skill before PRD drafting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Delivery_Mode",
    "Output_Artifacts",
    "Active_Sections",
    "Clarification_Confirmed",
    "Domain_Name",
    "Feature_Name",
    "Input_Type",
    "Core_Objective",
    "Problem_Statement",
    "JTBD_Candidates",
    "Target_Users",
    "Scope",
    "Glossary",
    "Epic_Candidates",
    "Primary_User_Story",
    "User_Story_Candidates",
    "User_Flow",
    "Business_Logic_and_Rules",
    "Functional_Requirements",
    "Non_Functional_Requirements",
    "Success_Metrics",
    "UI_UX_Requirements",
    "Dependencies_and_Impacted_Areas",
    "Known_Constraints",
    "Diagram_Requirements",
    "Assumptions",
    "Missing_Information"
  ],
  "properties": {
    "Delivery_Mode": {
      "type": "string",
      "description": "How the user wants the PRD workflow to run.",
      "enum": [
        "IDE_FULL_PIPELINE",
        "CHAT_TEXT_ONLY"
      ]
    },
    "Output_Artifacts": {
      "type": "array",
      "description": "Expected final outputs for the selected delivery mode.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Text Response",
          "Markdown File",
          "DOCX File"
        ]
      }
    },
    "Active_Sections": {
      "type": "array",
      "description": "PRD sections the user has confirmed they want included. Sections not listed here are skipped during drafting. Document Info and Summary are always included and are not listed.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Problem Statement",
          "JTBD",
          "Goals & Success Metrics",
          "Scope",
          "Glossary",
          "Feature Epics & User Stories",
          "Business Rules",
          "Process Diagrams",
          "Use Case Specifications",
          "Functional Requirements",
          "Non-Functional Requirements",
          "UI/UX Specifications",
          "Dependencies & Impacted Areas",
          "Assumptions & Open Questions"
        ]
      }
    },
    "Clarification_Confirmed": {
      "type": "boolean",
      "description": "Set to true only after the user has reviewed, corrected, and explicitly approved the structured JSON in the Step 1.5 clarification gate. Never set to true by the model without user confirmation."
    },
    "Domain_Name": {
      "type": "string",
      "description": "Lowercase kebab-case domain slug.",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "examples": ["loyalty-wallet", "payment-gateway", "user-profile"]
    },
    "Feature_Name": {
      "type": "string",
      "minLength": 1,
      "description": "Short human-readable feature name inferred from the input."
    },
    "Input_Type": {
      "type": "string",
      "enum": [
        "JTBDs",
        "Wireframe Notes",
        "Business Requirements",
        "Mixed"
      ]
    },
    "Core_Objective": {
      "$ref": "#/$defs/non_empty_or_needs_clarification"
    },
    "Problem_Statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["User_Problem", "Business_Problem"],
      "properties": {
        "User_Problem": {
          "$ref": "#/$defs/non_empty_or_needs_clarification"
        },
        "Business_Problem": {
          "$ref": "#/$defs/non_empty_or_needs_clarification"
        }
      }
    },
    "JTBD_Candidates": {
      "type": "array",
      "description": "JTBD signals extracted from the input. Product Framing will refine and validate these before drafting.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "User_Type",
          "Situation",
          "Motivation",
          "Expected_Outcome"
        ],
        "properties": {
          "User_Type": {
            "$ref": "#/$defs/non_empty_or_needs_clarification"
          },
          "Situation": {
            "$ref": "#/$defs/non_empty_or_needs_clarification"
          },
          "Motivation": {
            "$ref": "#/$defs/non_empty_or_needs_clarification"
          },
          "Expected_Outcome": {
            "$ref": "#/$defs/non_empty_or_needs_clarification"
          }
        }
      }
    },
    "Target_Users": {
      "$ref": "#/$defs/string_array"
    },
    "Scope": {
      "type": "object",
      "description": "What the feature covers and what it explicitly does not. Out_Of_Scope holds only items the user stated or confirmed.",
      "additionalProperties": false,
      "required": ["In_Scope", "Out_Of_Scope"],
      "properties": {
        "In_Scope": {
          "$ref": "#/$defs/string_array"
        },
        "Out_Of_Scope": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "Glossary": {
      "type": "array",
      "description": "Business terms, statuses, and roles a reader could misread, defined from the input context in plain language.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Term", "Meaning"],
        "properties": {
          "Term": {
            "$ref": "#/$defs/non_empty_or_needs_clarification"
          },
          "Meaning": {
            "$ref": "#/$defs/non_empty_or_needs_clarification"
          }
        }
      }
    },
    "Epic_Candidates": {
      "$ref": "#/$defs/string_array"
    },
    "Primary_User_Story": {
      "$ref": "#/$defs/non_empty_or_needs_clarification"
    },
    "User_Story_Candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Title", "Actor", "Action", "Value"],
        "properties": {
          "Title": {
            "$ref": "#/$defs/non_empty_or_needs_clarification"
          },
          "Actor": {
            "$ref": "#/$defs/non_empty_or_needs_clarification"
          },
          "Action": {
            "$ref": "#/$defs/non_empty_or_needs_clarification"
          },
          "Value": {
            "$ref": "#/$defs/non_empty_or_needs_clarification"
          }
        }
      }
    },
    "User_Flow": {
      "$ref": "#/$defs/string_array"
    },
    "Business_Logic_and_Rules": {
      "description": "One explicit, testable business rule per item, with concrete values and the condition that triggers it.",
      "$ref": "#/$defs/string_array"
    },
    "Functional_Requirements": {
      "$ref": "#/$defs/string_array"
    },
    "Non_Functional_Requirements": {
      "description": "Business-level expectations as users or the business experience them (perceived speed, availability, platforms, privacy, traceability, volume). No infrastructure.",
      "$ref": "#/$defs/string_array"
    },
    "Success_Metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Metric", "How_Measured", "Baseline", "Target"],
        "properties": {
          "Metric": {
            "$ref": "#/$defs/non_empty_or_needs_clarification"
          },
          "How_Measured": {
            "$ref": "#/$defs/non_empty_or_needs_clarification",
            "description": "Business definition: what is counted, for whom, over which period."
          },
          "Baseline": {
            "$ref": "#/$defs/non_empty_or_needs_clarification"
          },
          "Target": {
            "$ref": "#/$defs/non_empty_or_needs_clarification"
          }
        }
      }
    },
    "UI_UX_Requirements": {
      "$ref": "#/$defs/string_array"
    },
    "Dependencies_and_Impacted_Areas": {
      "description": "Business view only: teams, partners, or existing features this feature relies on or changes. Translate technical notes into business meaning; never list endpoints, payloads, or internal components.",
      "$ref": "#/$defs/string_array"
    },
    "Known_Constraints": {
      "description": "Constraints the user explicitly stated (including technical ones), copied as stated. Never inferred or expanded. Empty array if none.",
      "$ref": "#/$defs/string_array"
    },
    "Diagram_Requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "None",
          "Activity Diagram",
          "Sequence Diagram",
          "BPMN"
        ]
      }
    },
    "Assumptions": {
      "$ref": "#/$defs/string_array"
    },
    "Missing_Information": {
      "$ref": "#/$defs/string_array"
    }
  },
  "$defs": {
    "non_empty_or_needs_clarification": {
      "type": "string",
      "minLength": 1,
      "description": "Use [NEEDS_CLARIFICATION] when the source input does not provide this information."
    },
    "string_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_or_needs_clarification"
      }
    }
  }
}
